# ===========================================
# Food Co-Pilot Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# -------------------------------------------
# SUPABASE (Required)
# -------------------------------------------
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -------------------------------------------
# AI SERVICES (At least one required)
# -------------------------------------------

# Thesys AI - Primary AI service for Generative UI
# Get your key from: https://thesys.dev
THESYS_API_KEY=your-thesys-api-key

# Bytez AI - Backup/Fallback (Claude Opus 4.5)
# Get your key from: https://bytez.com
BYTEZ_API_KEY=your-bytez-api-key

# -------------------------------------------
# OPEN FOOD FACTS (Optional - for write operations)
# -------------------------------------------
# Create account at: https://world.openfoodfacts.org
# Only needed if you want to contribute data back
OFF_USERNAME=your-openfoodfacts-username
OFF_PASSWORD=your-openfoodfacts-password
